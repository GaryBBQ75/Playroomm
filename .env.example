# Local development: leave DATABASE_URL unset for guest-only mode.
PORT=8080
MAX_PLAYERS=8
ROUND_TIME=45
# Coolify Docker Compose variables (set actual secrets in Coolify only)
POSTGRES_DB=playroom
POSTGRES_USER=playroom
# POSTGRES_PASSWORD=<generate-a-long-random-password>
# APP_ORIGIN=https://your-playroom-domain.example
# GOOGLE_CLIENT_ID=<Google Cloud OAuth web client ID>
# GOOGLE_CLIENT_SECRET=<Google Cloud OAuth client secret>
# GOOGLE_REDIRECT_URI=https://your-playroom-domain.example/auth/google/callback
# COOKIE_SECURE=true
# REQUIRE_DATABASE=true
